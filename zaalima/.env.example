# ── Database ──────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://postgres:password@localhost:5432/zaalima

# ── JWT Authentication ─────────────────────────────────────────────────────────
SECRET_KEY=your-super-secret-jwt-key-change-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# ── Jira Cloud ────────────────────────────────────────────────────────────────
JIRA_BASE_URL=https://your-domain.atlassian.net
JIRA_EMAIL=your-email@example.com
JIRA_API_TOKEN=your_jira_api_token_here
JIRA_PROJECT_KEY=RR
JIRA_ISSUE_TYPE=Task

# ── CrowdStrike Falcon ────────────────────────────────────────────────────────
CROWDSTRIKE_CLIENT_ID=your_crowdstrike_client_id
CROWDSTRIKE_CLIENT_SECRET=your_crowdstrike_client_secret
CROWDSTRIKE_API_BASE_URL=https://api.us-2.crowdstrike.com

# ── Microsoft Defender ────────────────────────────────────────────────────────
DEFENDER_TENANT_ID=your_tenant_id
DEFENDER_CLIENT_ID=your_client_id
DEFENDER_CLIENT_SECRET=your_client_secret

# ── AWS S3 Evidence Storage ───────────────────────────────────────────────────
AWS_ACCESS_KEY_ID=your_aws_access_key
AWS_SECRET_ACCESS_KEY=your_aws_secret_key
AWS_REGION=us-east-1
S3_EVIDENCE_BUCKET=zaalima-forensic-evidence

# ── Frontend ──────────────────────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_WS_URL=ws://localhost:8000

