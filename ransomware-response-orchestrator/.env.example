# ==============================================================================
# Automated Ransomware Containment & Incident Response Orchestrator - Day 1
# Environment Configuration Template
# ==============================================================================
# Instructions:
# 1. Copy this file to '.env':
#      Windows PowerShell: Copy-Item .env.example .env
#      Command Prompt:     copy .env.example .env
# 2. Fill in your Azure Active Directory (Microsoft Entra ID) and Defender API values.
# 3. For local testing without active Azure/Defender credentials, set:
#      EDR_MOCK_MODE=true
#
# IMPORTANT SECURITY NOTICE:
# - NEVER commit the actual '.env' file to GitHub or any source control repository.
# - Keep API keys and Client Secrets secure in production vaults.
# ==============================================================================

# Execution Mode: Set to 'true' to use simulated Defender API responses without real credentials.
# Set to 'false' when connecting to live Microsoft Defender for Endpoint API.
EDR_MOCK_MODE=true

# Microsoft Entra ID (Azure AD) Directory / Tenant ID (GUID)
# Required when EDR_MOCK_MODE=false
DEFENDER_TENANT_ID=00000000-0000-0000-0000-000000000000

# Registered App (Service Principal) Client / Application ID (GUID)
# Required when EDR_MOCK_MODE=false
DEFENDER_CLIENT_ID=00000000-0000-0000-0000-000000000000

# Client Secret generated in Azure App Registrations -> Certificates & Secrets
# Required when EDR_MOCK_MODE=false
DEFENDER_CLIENT_SECRET=replace_with_your_azure_client_secret_value

# Microsoft Defender for Endpoint Base API URL (Commercial Cloud default)
# Government Cloud: https://api-gcc.securitycenter.microsoft.us
DEFENDER_API_BASE_URL=https://api.securitycenter.microsoft.com

# HTTP Request Timeout in seconds (recommended: 10 to 30)
EDR_TIMEOUT_SECONDS=15

# Logging level: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# ==============================================================================
# Day 2: Forensic Evidence Collection Configuration
# ==============================================================================
# Path to local directory where forensic evidence manifests and metadata are persisted.
# Defaults to: <project_root>/evidence/metadata
EVIDENCE_DIR=./evidence/metadata

# Default collection mechanism: KAPE, RAM, or INVESTIGATION_PACKAGE
DEFAULT_COLLECTION_METHOD=KAPE

# Comma-separated default KAPE artifact categories (options: Registry,FileSystem,EventLogs,Execution,Persistence,Browser,Network)
KAPE_ARTIFACT_CATEGORIES=Registry,FileSystem,EventLogs,Execution,Persistence

# Maximum polling wait time in seconds for synchronous tracking
COLLECTION_POLL_TIMEOUT_SECONDS=30

# ==============================================================================
# Day 3: Secure AWS S3 Evidence Storage Configuration
# ==============================================================================
# S3 Mock Mode: Set to 'true' to simulate S3 uploads locally without AWS credentials.
# Set to 'false' to connect to live AWS S3 storage.
S3_MOCK_MODE=true

# AWS S3 Bucket Name for storing forensic evidence packages
# Required when S3_MOCK_MODE=false
AWS_S3_BUCKET_NAME=my-soc-forensic-evidence-vault

# AWS Region where the evidence bucket is hosted
AWS_REGION=us-east-1

# S3 Key Prefix (hierarchy root: e.g., incidents -> incidents/{id}/evidence/{job}/...)
S3_EVIDENCE_PREFIX=incidents

# Server-Side Encryption: AES256 (SSE-S3) or aws:kms (SSE-KMS)
AWS_SERVER_SIDE_ENCRYPTION=AES256

# Optional: AWS KMS Key ID or ARN for SSE-KMS customer managed encryption
# AWS_KMS_KEY_ID=arn:aws:kms:us-east-1:123456789012:key/your-key-id

# Optional: Named AWS CLI Profile (defaults to standard credentials provider chain / IAM role)
# AWS_PROFILE=soc-incident-response

# Optional: S3 Endpoint URL (for S3 VPC endpoints or local testing)
# AWS_S3_ENDPOINT_URL=
