# ==============================================================================
# Automated Ransomware Containment & Incident Response Orchestrator
# Day 1: Jira Cloud REST API Integration - Environment Configuration Template
# ==============================================================================
#
# INSTRUCTIONS:
# 1. Copy this file to .env:
#    cp .env.example .env     (Linux/macOS)
#    copy .env.example .env   (Windows PowerShell / CMD)
# 2. Replace the placeholder values below with your real Jira Cloud credentials.
# 3. NEVER commit your real .env file into Git. It is excluded in .gitignore.
# ==============================================================================

# ── Jira Cloud Connection ─────────────────────────────────────────────────────
# The HTTPS base URL of your Atlassian Jira Cloud instance.
# Example: https://mysecops.atlassian.net
JIRA_BASE_URL=https://your-domain.atlassian.net

# ── Jira Authentication ───────────────────────────────────────────────────────
# The email address associated with your Atlassian / Jira Cloud account.
# Example: security_analyst@company.com
JIRA_EMAIL=your-email@example.com

# Your Jira Cloud REST API token.
# Generate one at: https://id.atlassian.com/manage-profile/security/api-tokens
# NEVER hardcode or commit this value.
JIRA_API_TOKEN=your_jira_api_token_here

# ── Jira Project & Issue Configuration ────────────────────────────────────────
# The Key of the Jira project where security incident tickets will be created.
# Examples: SEC, SOC, INC, IT, KAN
JIRA_PROJECT_KEY=SEC

# The issue type name for incident tickets in your Jira project.
# Standard options: Task, Incident, Bug, Story (Default: Task)
JIRA_ISSUE_TYPE=Task

# ── Operational & Security Settings ──────────────────────────────────────────
# Network timeout in seconds for Jira API requests (Default: 10)
JIRA_TIMEOUT_SECONDS=10

# Enforce TLS/SSL certificate verification (true/false, Default: true)
JIRA_VERIFY_SSL=true

# Logging Level: DEBUG, INFO, WARNING, ERROR, CRITICAL (Default: INFO)
LOG_LEVEL=INFO

