# .env.example
# ─────────────────────────────────────────────────────────────────────────────
# Automated Ransomware Containment & Incident Response Orchestrator
# Day 3 -- EDR API Integration Configuration Template
#
# HOW TO USE:
#   1. Copy this file to .env  (cp .env.example .env  or  copy .env.example .env)
#   2. Fill in your real credentials below.
#   3. NEVER commit the .env file to Git. It is already excluded by .gitignore.
# ─────────────────────────────────────────────────────────────────────────────

# ── Choose your EDR provider ──────────────────────────────────────────────────
# Allowed values: crowdstrike | defender
EDR_PROVIDER=

# ── API base URL ──────────────────────────────────────────────────────────────
# CrowdStrike:  https://api.crowdstrike.com
# Defender:     https://api.securitycenter.microsoft.com
EDR_API_BASE_URL=

# ── OAuth 2.0 credentials ─────────────────────────────────────────────────────
# CrowdStrike: created in Falcon Console > API Clients & Keys
# Defender:    created in Azure AD > App Registrations
EDR_CLIENT_ID=
EDR_CLIENT_SECRET=

# ── Microsoft Defender only ───────────────────────────────────────────────────
# Your Azure Active Directory tenant ID (leave blank for CrowdStrike)
EDR_TENANT_ID=

# ── Network settings ──────────────────────────────────────────────────────────
# Timeout in seconds for all API requests (default: 10)
EDR_TIMEOUT_SECONDS=10

# ── Webhook Security (Day 4) ──────────────────────────────────────────────────
# Shared secret for authenticating incoming EDR webhook requests (POST /webhook/edr).
# Webhook clients must provide this value in the 'X-Webhook-Secret' HTTP header.
# NEVER commit your actual secret to version control.
WEBHOOK_SECRET=your-secure-webhook-secret-here

# ── Network Containment & Execution Safety Mode (Week 2 Day 2) ─────────────────
# Safety controls for automated EDR endpoint isolation.
# EDR_EXECUTION_MODE: 'dry_run' (default) or 'live'
# EDR_DRY_RUN: 'true' (default) or 'false'
# In dry_run mode, containment decisions are evaluated but NO real API requests
# are sent to the EDR platform. Set to 'live' and 'false' only in authorized test environments.
EDR_EXECUTION_MODE=dry_run
EDR_DRY_RUN=true

# ── Identity Provider Integration (Week 2 Day 4 & Day 5) ─────────────────────
# Provider choice: 'mock' (default for testing) | 'entra_id' (Microsoft Entra ID / Graph API)
IDENTITY_PROVIDER=mock

# ── Microsoft Entra ID / Microsoft Graph API Configuration ────────────────────
# Directory / Tenant ID (required for Entra ID OAuth 2.0 client credentials)
IDENTITY_TENANT_ID=your-azure-tenant-id-here

# Application (client) ID registered in Azure Portal / Microsoft Entra admin center
IDENTITY_CLIENT_ID=your-application-client-id-here

# Client Secret generated under Certificates & Secrets
IDENTITY_CLIENT_SECRET=your-client-secret-here

# Microsoft Graph API Base URL (defaults to https://graph.microsoft.com)
IDENTITY_GRAPH_BASE_URL=https://graph.microsoft.com

# HTTP timeout in seconds for Graph API requests (default: 10)
IDENTITY_TIMEOUT_SECONDS=10

# ── Identity Response Execution Mode & Safeguards ─────────────────────────────
# Mode: 'dry_run' (default) or 'live'
# Dry-run setting: 'true' (default) or 'false'
# In dry_run mode, identity evaluations are performed and simulated responses
# returned without modifying any real accounts or invalidating real sessions.
IDENTITY_EXECUTION_MODE=dry_run
IDENTITY_DRY_RUN=true

# Accounts protected against automated suspension and session revocation
# (comma-separated list; emergency admins, break-glass, and orchestrator accounts are protected by default)
IDENTITY_PROTECTED_ACCOUNTS=admin,administrator,breakglass,break-glass,emergency,emergency-admin,orchestrator,svc-orchestrator

# Optional allowlist of test accounts permitted for live modification in authorized environments
# IDENTITY_TEST_ACCOUNT_ALLOWLIST=test-user-001@yourtenant.onmicrosoft.com

