# .env.example
# ─────────────────────────────────────────────────────────────────────────────
# Automated Ransomware Containment & Incident Response Orchestrator
# Day 3 -- EDR API Integration Configuration Template
#
# HOW TO USE:
#   1. Copy this file to .env  (cp .env.example .env  or  copy .env.example .env)
#   2. Fill in your real credentials below.
#   3. NEVER commit the .env file to Git. It is already excluded by .gitignore.
# ─────────────────────────────────────────────────────────────────────────────

# ── Choose your EDR provider ──────────────────────────────────────────────────
# Allowed values: crowdstrike | defender
EDR_PROVIDER=

# ── API base URL ──────────────────────────────────────────────────────────────
# CrowdStrike:  https://api.crowdstrike.com
# Defender:     https://api.securitycenter.microsoft.com
EDR_API_BASE_URL=

# ── OAuth 2.0 credentials ─────────────────────────────────────────────────────
# CrowdStrike: created in Falcon Console > API Clients & Keys
# Defender:    created in Azure AD > App Registrations
EDR_CLIENT_ID=
EDR_CLIENT_SECRET=

# ── Microsoft Defender only ───────────────────────────────────────────────────
# Your Azure Active Directory tenant ID (leave blank for CrowdStrike)
EDR_TENANT_ID=

# ── Network settings ──────────────────────────────────────────────────────────
# Timeout in seconds for all API requests (default: 10)
EDR_TIMEOUT_SECONDS=10

# ── Webhook Security (Day 4) ──────────────────────────────────────────────────
# Shared secret for authenticating incoming EDR webhook requests (POST /webhook/edr).
# Webhook clients must provide this value in the 'X-Webhook-Secret' HTTP header.
# NEVER commit your actual secret to version control.
WEBHOOK_SECRET=your-secure-webhook-secret-here

